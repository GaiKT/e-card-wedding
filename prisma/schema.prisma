// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Blessing model for wedding blessings
model Blessing {
  id         String   @id @default(cuid())
  name       String
  email      String?
  message    String
  willAttend Boolean? // เพิ่ม field สำหรับการเข้าร่วมงาน (nullable)
  hasDonated Boolean? @default(false) // เพิ่ม field สำหรับการบริจาค (nullable)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("blessings")
}
